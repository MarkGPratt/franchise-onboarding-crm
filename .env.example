# Supabase (or databasepad.com) project credentials.
# Copy this file to ".env" and fill in your project's values.
#
# Defaults to the original databasepad.com project if left unset, so the
# app will run without a .env file — but you should switch to your own
# Supabase project (see database.sql) for full control.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
